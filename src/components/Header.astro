---
import { Icon } from 'astro-icon/components'
import Logo from './Logo.astro'
import { contact } from '../data/contact'
import { services } from '../data/services'
import { serviceAreas } from '../data/service-areas'

const mainLinks = [
  { name: 'Projects', href: '/projects' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' },
]

const navLink = 'text-[0.9375rem] font-medium text-stone-700 hover:text-ridge-700 transition-colors focus-ring rounded-sm'
const dropdownLink = 'block px-4 py-2 text-[0.9375rem] text-stone-700 hover:bg-ridge-50 hover:text-ridge-800 transition-colors'
const mobileLabel = 'text-xs font-medium uppercase tracking-wider text-stone-400 mb-2'
const mobileLink = 'block py-2 text-lg text-stone-800 active:text-ridge-700'
---

<header class="bg-white/95 backdrop-blur-sm sticky top-0 z-50 border-b border-stone-200">
  <!-- Desktop-only strip; on mobile FloatingContact covers call/text -->
  <div class="hidden lg:block bg-ridge-800 text-white">
    <div class="container-wide section-padding">
      <div class="flex justify-between items-center py-1.5 text-[0.8125rem]">
        <span class="text-ridge-200">Licensed general contractor in Etowah, TN</span>
        <button
          type="button"
          data-copy={contact.phone}
          data-track="copy_phone_header"
          title="Copy phone number"
          class="group inline-flex items-center gap-2 font-medium text-white transition-colors"
        >
          {contact.phone}
          <span class="text-xs font-normal text-ridge-300 group-hover:text-white transition-colors">Copy</span>
        </button>
      </div>
    </div>
  </div>

  <nav class="container-wide section-padding" aria-label="Main navigation">
    <div class="flex items-center justify-between h-[4.5rem]">
      <a href="/" class="flex items-center gap-3 focus-ring rounded-sm">
        <Logo class="h-12 w-auto" />
        <div class="flex flex-col">
          <span class="font-display font-semibold text-lg text-stone-900 leading-tight">Maple Ridge</span>
          <span class="text-[0.65rem] uppercase tracking-[0.14em] text-stone-500 leading-tight mt-0.5">Construction &amp; Development</span>
        </div>
      </a>

      <div class="hidden lg:flex items-center gap-7 whitespace-nowrap">
        <div class="relative group">
          <button type="button" class={`flex items-center gap-1 py-2 ${navLink}`} aria-haspopup="true">
            Services
            <Icon name="lucide:chevron-down" class="h-3.5 w-3.5" />
          </button>
          <div class="absolute -left-4 top-full pt-1 w-56 hidden group-hover:block group-focus-within:block">
            <div class="bg-white rounded-lg shadow-md border border-stone-200 py-1.5">
              {services.map((item) => (
                <a href={item.href} class={dropdownLink}>{item.name}</a>
              ))}
            </div>
          </div>
        </div>

        <div class="relative group">
          <button type="button" class={`flex items-center gap-1 py-2 ${navLink}`} aria-haspopup="true">
            Service areas
            <Icon name="lucide:chevron-down" class="h-3.5 w-3.5" />
          </button>
          <div class="absolute -left-4 top-full pt-1 w-56 hidden group-hover:block group-focus-within:block">
            <div class="bg-white rounded-lg shadow-md border border-stone-200 py-1.5">
              {serviceAreas.map((area) => (
                <a href={`/service-areas/${area.slug}`} class={dropdownLink}>{area.name}</a>
              ))}
              <a href="/service-areas" class={`${dropdownLink} mt-1.5 pt-2.5 border-t border-stone-200 text-stone-500`}>All service areas</a>
            </div>
          </div>
        </div>

        {mainLinks.map((item) => (
          <a href={item.href} class={`py-2 ${navLink}`}>{item.name}</a>
        ))}

        <a href="/contact" class="btn-primary px-5 py-2.5 text-[0.9375rem]">Get a quote</a>
      </div>

      <button
        type="button"
        id="mobile-menu-button"
        class="lg:hidden relative z-10 p-3 -mr-3 text-stone-700 hover:text-ridge-600 active:text-ridge-700 focus-ring rounded-lg"
        style="touch-action: manipulation"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only" data-label-open>Open menu</span>
        <span class="sr-only hidden" data-label-close>Close menu</span>
        <Icon name="lucide:menu" class="h-6 w-6" data-icon-menu />
        <Icon name="lucide:x" class="h-6 w-6 hidden" data-icon-close />
      </button>
    </div>
  </nav>

  <!-- Mobile menu: full-height panel under the header bar -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden absolute inset-x-0 top-full h-[calc(100dvh-4.5rem)] overflow-y-auto overscroll-contain bg-white border-t border-stone-200"
  >
    <div class="section-padding py-6 flex flex-col min-h-full">
      <div>
        <p class={mobileLabel}>Services</p>
        {services.map((item) => (
          <a href={item.href} class={mobileLink}>{item.name}</a>
        ))}
      </div>

      <div class="mt-6 pt-6 border-t border-stone-200">
        <p class={mobileLabel}>Service areas</p>
        <div class="grid grid-cols-2 gap-x-4">
          {serviceAreas.map((area) => (
            <a href={`/service-areas/${area.slug}`} class={mobileLink}>{area.name}</a>
          ))}
        </div>
      </div>

      <div class="mt-6 pt-6 border-t border-stone-200">
        {mainLinks.map((item) => (
          <a href={item.href} class={mobileLink}>{item.name}</a>
        ))}
      </div>

      <div class="mt-auto pt-8 space-y-3">
        <a href="/contact" class="btn-primary w-full py-3.5">Get a free quote</a>
        <a href={contact.phoneHref} data-track="call_mobile_menu" class="btn-outline w-full py-3.5">
          Call {contact.phone}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button')
  const menu = document.getElementById('mobile-menu')
  const iconMenu = button?.querySelector('[data-icon-menu]') as HTMLElement | null
  const iconClose = button?.querySelector('[data-icon-close]') as HTMLElement | null
  const labelOpen = button?.querySelector('[data-label-open]') as HTMLElement | null
  const labelClose = button?.querySelector('[data-label-close]') as HTMLElement | null

  function setMenu(open: boolean) {
    menu?.classList.toggle('hidden', !open)
    button?.setAttribute('aria-expanded', String(open))
    iconMenu?.classList.toggle('hidden', open)
    iconClose?.classList.toggle('hidden', !open)
    labelOpen?.classList.toggle('hidden', open)
    labelClose?.classList.toggle('hidden', !open)
    // The panel fills the screen, so the page behind it shouldn't scroll
    document.documentElement.classList.toggle('overflow-hidden', open)
  }

  button?.addEventListener('click', () => setMenu(menu?.classList.contains('hidden') ?? false))
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) setMenu(false)
  })
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false)
  })
</script>
