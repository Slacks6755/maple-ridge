---
// Short lead form (name, phone, optional message) for the CTA band.
// Netlify form "quick-contact" — separate from the full "contact" form on
// /contact, since Netlify only keeps the fields it saw in a form's first
// detected definition. The hidden "page" field tells Zack where the lead
// came from.
import { contact } from '../data/contact'

interface Props {
  submitLabel?: string
  /** Tighter card with a one-line details field (homepage hero) */
  compact?: boolean
}

const { submitLabel = 'Send', compact = false } = Astro.props
const page = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/'
const inputClass =
  'w-full px-4 py-3 rounded-sm border border-stone-300 bg-white text-stone-900 focus:border-ridge-500 focus:ring-2 focus:ring-ridge-500/20 transition-colors'
---

<div class={`card text-left text-stone-900 ${compact ? 'p-5 sm:p-6' : 'p-6 sm:p-8'}`} data-quick-form-root>
  <form
    name="quick-contact"
    method="POST"
    action="/"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    class={compact ? 'space-y-4' : 'space-y-5'}
    data-quick-form
  >
    <input type="hidden" name="form-name" value="quick-contact" />
    <input type="hidden" name="page" value={page} />
    <p class="hidden">
      <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>

    <div class={`grid sm:grid-cols-2 ${compact ? 'gap-4' : 'gap-5'}`}>
      <div>
        <label for="qc-name" class="block text-sm font-medium text-stone-700 mb-2">Name</label>
        <input type="text" id="qc-name" name="name" required autocomplete="name" class={inputClass} />
      </div>
      <div>
        <label for="qc-phone" class="block text-sm font-medium text-stone-700 mb-2">Phone</label>
        <input type="tel" id="qc-phone" name="phone" required autocomplete="tel" class={inputClass} />
      </div>
    </div>

    <div>
      <label for="qc-message" class="block text-sm font-medium text-stone-700 mb-2">
        Project details <span class="font-normal text-stone-400">(optional)</span>
      </label>
      {compact ? (
        <input type="text" id="qc-message" name="message" placeholder="What do you need done?" class={inputClass} />
      ) : (
        <textarea
          id="qc-message"
          name="message"
          rows="3"
          placeholder="What do you need done?"
          class={`${inputClass} resize-none`}
        ></textarea>
      )}
    </div>

    <p class="hidden text-sm text-red-700" data-error role="alert">
      That didn&apos;t go through. Please try again or call {contact.phone}.
    </p>

    <button
      type="submit"
      class="btn-primary w-full justify-center disabled:opacity-60 disabled:cursor-not-allowed"
      data-submit
    >
      <span data-submit-idle>{submitLabel}</span>
      <span class="hidden" data-submit-busy>Sending&hellip;</span>
    </button>
  </form>

  <div class="hidden py-8 text-center" data-success role="status">
    <p class="font-display text-2xl font-semibold text-ridge-700 mb-2">Got it, thanks.</p>
    <p class="text-stone-600">Zack will call you back at the number you gave.</p>
  </div>
</div>

<script>
  import { trackEvent } from '../lib/analytics'

  document.querySelectorAll<HTMLElement>('[data-quick-form-root]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-quick-form]')
    const error = root.querySelector<HTMLElement>('[data-error]')
    const success = root.querySelector<HTMLElement>('[data-success]')
    const submit = root.querySelector<HTMLButtonElement>('[data-submit]')
    const labelIdle = root.querySelector<HTMLElement>('[data-submit-idle]')
    const labelBusy = root.querySelector<HTMLElement>('[data-submit-busy]')
    if (!form) return

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      error?.classList.add('hidden')
      submit?.setAttribute('disabled', '')
      labelIdle?.classList.add('hidden')
      labelBusy?.classList.remove('hidden')

      try {
        const data = new URLSearchParams(new FormData(form) as unknown as Record<string, string>)
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: data.toString(),
        })
        if (!res.ok) throw new Error('submission failed')
        form.classList.add('hidden')
        success?.classList.remove('hidden')
        trackEvent('generate_lead', 'contact', `quick_form:${data.get('page')}`)
      } catch {
        error?.classList.remove('hidden')
      } finally {
        submit?.removeAttribute('disabled')
        labelIdle?.classList.remove('hidden')
        labelBusy?.classList.add('hidden')
      }
    })
  })
</script>
