---
import { Image } from 'astro:assets'
import tree from '../assets/brand/tree.png'

interface Props {
  class?: string
}
const { class: className = 'h-12 w-auto' } = Astro.props
---

<Image
  src={tree}
  alt="Maple Ridge Construction logo"
  height={48}
  densities={[1, 2, 3]}
  loading="eager"
  class={className}
/>
