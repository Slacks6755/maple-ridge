---
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { projects } from '../data/projects'

interface Photo {
  src: ImageMetadata
  alt: string
  /** Optional corner tag, e.g. "Before" / "After" */
  tag?: string
}

interface Props {
  photos: Photo[]
  /** Project slug — caption and link come from src/data/projects.ts */
  project: string
  class?: string
}

const { photos, project: slug, class: className = '' } = Astro.props
const project = projects.find((p) => p.slug === slug)
const cols = photos.length === 3 ? 'sm:grid-cols-3' : photos.length === 2 ? 'sm:grid-cols-2' : ''
---

<figure class={className}>
  <div class={`grid gap-3 ${cols}`}>
    {photos.map((photo) => (
      <div class="relative overflow-hidden rounded-lg bg-stone-200 aspect-[4/3]">
        <Picture
          src={photo.src}
          formats={['avif']}
          fallbackFormat="webp"
          alt={photo.alt}
          widths={[400, 700, 1000]}
          sizes={photos.length > 1 ? '(min-width: 640px) 33vw, 100vw' : '(min-width: 1024px) 40vw, 100vw'}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover"
        />
        {photo.tag && (
          <span class="absolute left-3 top-3 rounded-sm bg-stone-900/80 px-2.5 py-1 text-xs font-medium uppercase tracking-[0.18em] text-white">
            {photo.tag}
          </span>
        )}
      </div>
    ))}
  </div>
  {project && (
    <figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 text-sm text-stone-500">
      <span>{project.title}, {project.location}</span>
      <a href={`/projects#${project.slug}`} class="text-link">See the full project</a>
    </figcaption>
  )}
</figure>
