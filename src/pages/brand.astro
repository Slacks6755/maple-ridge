---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'

// Download page for Zack and anyone he sends files to (printers, sign shops).
// Unlisted: noindex, not in the nav, sitemap, or llms.txt. Files live in
// public/brand/ and are generated by `npm run brand-kit`
// (scripts/brand-kit/render.py); file names here must match that script.
// Downloads skip data-track on purpose: the BaseLayout listener logs those as
// contact clicks.

const title = 'Brand Files | Maple Ridge Construction'
const description = 'Maple Ridge logos, business cards, and social media images to download.'

const dir = '/brand'
const f = (folder: string, name: string, ext: string) => `${dir}/${folder}/maple-ridge-${name}.${ext}`
const preview = (name: string) => `${dir}/previews/${name}.webp`

const colors = [
  { key: 'black', label: 'Black' },
  { key: 'white', label: 'White' },
  { key: 'green', label: 'Green' },
]

const logos = [
  { key: 'logo', title: 'Full logo', note: 'The main logo. Use it when there’s room.' },
  { key: 'logo-name', title: 'Name only', note: 'Same logo without “Construction & Development.” Cleaner when it’s small.' },
  { key: 'logo-horizontal', title: 'Horizontal', note: 'For wide spaces like letterhead, estimates, and invoices.', wide: true },
  { key: 'logo-horizontal-name', title: 'Horizontal, name only', note: 'Wide and short. Fits narrow spots like a website header.', wide: true },
  { key: 'tree', title: 'Tree only', note: 'Just the tree. Good for stickers, stamps, embroidery, or a small mark.' },
]

const cards = [
  { key: 'card-front-cream', title: 'Front, cream', note: 'With “Construction & Development.”' },
  { key: 'card-front-cream-name', title: 'Front, cream, name only', note: 'Just the tree and the name.' },
  { key: 'card-back-cream', title: 'Back, cream', note: 'Zack’s name, phone, email, and website.' },
  { key: 'card-front-green', title: 'Front, green', note: 'With “Construction & Development.”' },
  { key: 'card-front-green-name', title: 'Front, green, name only', note: 'Just the tree and the name.' },
  { key: 'card-back-green', title: 'Back, green', note: 'Zack’s name, phone, email, and website.' },
]

const social = [
  {
    title: 'Profile pictures',
    note: 'Square, with room for the circle crop. The tree alone is easiest to see at small sizes.',
    shape: 'aspect-square',
    cols: 'grid-cols-2 lg:grid-cols-4',
    round: true,
    items: [
      { key: 'profile-tree-green', title: 'Tree on green', note: 'Our pick for Facebook and Instagram.' },
      { key: 'profile-tree-cream', title: 'Tree on cream' },
      { key: 'profile-name-green', title: 'Name on green', note: 'Good for Google and LinkedIn.' },
      { key: 'profile-name-cream', title: 'Name on cream' },
    ],
  },
  {
    title: 'Cover photos',
    note: 'For the top of the Facebook page. Phones trim the sides, so everything sits in the middle.',
    shape: 'aspect-[1640/624]',
    cols: 'sm:grid-cols-2 lg:grid-cols-3',
    items: [
      { key: 'cover-green', title: 'Green' },
      { key: 'cover-green-name', title: 'Green, name only' },
      { key: 'cover-cream', title: 'Cream' },
    ],
  },
  {
    title: 'Posts',
    note: 'Square post with the phone number, for Facebook or Instagram.',
    shape: 'aspect-square',
    cols: 'grid-cols-2 lg:grid-cols-4',
    items: [
      { key: 'post-cream', title: 'Cream' },
      { key: 'post-green', title: 'Green' },
    ],
  },
  {
    title: 'Stories',
    note: 'Full phone screen, for Facebook and Instagram stories.',
    shape: 'aspect-[9/16]',
    cols: 'grid-cols-2 lg:grid-cols-4',
    items: [
      { key: 'story-green', title: 'Green' },
      { key: 'story-cream', title: 'Cream' },
    ],
  },
]

const signatures = [
  { key: 'email-signature', title: 'Full', note: 'Name, title, phone, email, and website.' },
  { key: 'email-signature-green', title: 'Full, green', note: 'Same info on the dark green.' },
  { key: 'email-signature-compact', title: 'Short', note: 'Name, company, and phone. Good for quick replies.' },
]

const swatches = [
  { name: 'Ridge green', hex: '#263326' },
  { name: 'Leaf green', hex: '#374b37' },
  { name: 'Cream', hex: '#faf8f5' },
  { name: 'Ink', hex: '#1c1c1a' },
  { name: 'Earth', hex: '#a0825f' },
]

const dl = 'font-medium text-ridge-800 underline decoration-ridge-300 underline-offset-4 hover:decoration-ridge-700'
---

<BaseLayout title={title} description={description} noindex>
  <PageHero
    label="Brand files"
    title="Logos and brand files"
    description="Logos, business cards, and social media images for Maple Ridge. Pick what you need and download it."
    showCTA={false}
  />

  <section class="py-12 lg:py-14 border-b border-stone-200">
    <div class="container-wide section-padding flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-8">
      <a href={`${dir}/maple-ridge-brand-kit.zip`} download class="btn-primary">Download everything (13 MB)</a>
      <p class="text-stone-800">Every file on this page in one zip.</p>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="container-wide section-padding">
      <span class="section-label">Logos</span>
      <h2 class="section-title">Logos</h2>
      <p class="section-subtitle">Each one comes in black, white, and green.</p>

      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {logos.map((logo) => (
          <article class="card flex flex-col">
            <div class={`grid ${logo.wide ? 'grid-rows-2' : 'grid-cols-2'} aspect-[4/3] overflow-hidden border-b border-stone-200`}>
              <div class="bg-earth-50 flex items-center justify-center p-5 min-h-0 min-w-0">
                <img src={preview(`${logo.key}-black`)} alt={`${logo.title}, black`} loading="lazy" class="max-h-full max-w-full object-contain" />
              </div>
              <div class="bg-ridge-900 flex items-center justify-center p-5 min-h-0 min-w-0">
                <img src={preview(`${logo.key}-white`)} alt={`${logo.title}, white`} loading="lazy" class="max-h-full max-w-full object-contain" />
              </div>
            </div>
            <div class="p-6 flex-1 flex flex-col">
              <h3 class="font-display text-xl font-semibold text-stone-900">{logo.title}</h3>
              <p class="mt-1 text-stone-700">{logo.note}</p>
              <table class="mt-5 w-full text-sm">
                <tbody>
                  {colors.map((c) => (
                    <tr class="border-t border-stone-200">
                      <th scope="row" class="py-2.5 pr-4 text-left font-medium text-stone-700">{c.label}</th>
                      {['png', 'pdf', 'svg'].map((ext) => (
                        <td class="py-2.5 text-right">
                          <a href={f('logos', `${logo.key}-${c.key}`, ext)} download class={dl}>{ext.toUpperCase()}</a>
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white border-y border-stone-200">
    <div class="container-wide section-padding">
      <span class="section-label">Print</span>
      <h2 class="section-title">Business cards</h2>
      <p class="section-subtitle">
        Standard 3.5 × 2 inch cards. Pick one front and one back, then upload the PDFs to your printer.
        If they ask about bleed, have them extend the background color.
      </p>

      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {cards.map((card) => (
          <article class="card flex flex-col">
            <div class="aspect-[7/4] bg-stone-100 flex items-center justify-center p-5 border-b border-stone-200">
              <img src={preview(card.key)} alt={`Business card ${card.title.toLowerCase()}`} loading="lazy" class="max-h-full max-w-full object-contain shadow-sm" />
            </div>
            <div class="p-6 flex-1 flex flex-col">
              <h3 class="font-display text-xl font-semibold text-stone-900">{card.title}</h3>
              <p class="mt-1 text-stone-700">{card.note}</p>
              <p class="mt-auto pt-5 flex justify-end gap-6 text-sm">
                <a href={f('business-cards', card.key, 'pdf')} download class={dl}>Print PDF</a>
                <a href={f('business-cards', card.key, 'png')} download class={dl}>PNG</a>
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="container-wide section-padding">
      <span class="section-label">Email</span>
      <h2 class="section-title">Email signatures</h2>
      <p class="section-subtitle">
        Add one as a picture in your email signature settings and set it to about 500 pixels wide.
      </p>

      <div class="mt-12 grid md:grid-cols-2 gap-6">
        {signatures.map((sig) => (
          <article class="card flex flex-col">
            <div class="bg-stone-100 px-6 py-10 border-b border-stone-200 flex items-center justify-center min-h-56">
              <img src={preview(sig.key)} alt={`Email signature: ${sig.title.toLowerCase()}`} loading="lazy" class="w-full max-w-[500px] shadow-sm" />
            </div>
            <div class="p-6 flex-1 flex flex-col">
              <h3 class="font-display text-xl font-semibold text-stone-900">{sig.title}</h3>
              <p class="mt-1 text-stone-700">{sig.note}</p>
              <p class="mt-auto pt-5 text-sm text-right">
                <a href={f('email', sig.key, 'png')} download class={dl}>PNG</a>
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white border-y border-stone-200">
    <div class="container-wide section-padding">
      <span class="section-label">Social media</span>
      <h2 class="section-title">Social media images</h2>
      <p class="section-subtitle">Made at double size so they stay sharp after Facebook and Instagram compress them.</p>

      {social.map((group) => (
        <div class="mt-14">
          <h3 class="font-display text-2xl font-semibold text-stone-900">{group.title}</h3>
          <p class="mt-1 text-stone-700 max-w-2xl">{group.note}</p>
          <div class={`mt-6 grid gap-6 ${group.cols}`}>
            {group.items.map((item) => (
              <article class="card flex flex-col">
                <div class="bg-stone-100 p-5 border-b border-stone-200 flex items-center justify-center">
                  <img
                    src={preview(item.key)}
                    alt={`${group.title}: ${item.title}`}
                    loading="lazy"
                    class={`w-full ${group.shape} object-cover ${group.round ? 'rounded-full' : 'shadow-sm'}`}
                  />
                </div>
                <div class="p-5 flex-1 flex flex-col">
                  <h4 class="font-semibold text-stone-900">{item.title}</h4>
                  {item.note && <p class="mt-1 text-sm text-stone-700">{item.note}</p>}
                  <p class="mt-auto pt-4 text-sm text-right">
                    <a href={f('social', item.key, 'png')} download class={dl}>PNG</a>
                  </p>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="container-wide section-padding grid lg:grid-cols-[1.4fr,1fr] gap-12 lg:gap-16">
      <div>
        <span class="section-label">For designers</span>
        <h2 class="section-title">Colors</h2>
        <ul class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-4">
          {swatches.map((s) => (
            <li class="card">
              <div class="h-16 border-b border-stone-200" style={`background:${s.hex}`}></div>
              <div class="p-3 text-sm">
                <p class="font-semibold text-stone-900">{s.name}</p>
                <p class="font-mono text-stone-700">{s.hex}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="section-title lg:mt-9">Fonts</h2>
        <div class="mt-8 space-y-6">
          <div>
            <p class="font-display text-3xl font-semibold text-stone-900">Source Serif 4</p>
            <p class="mt-1 text-stone-700">The name, headings, and phone numbers.</p>
          </div>
          <div>
            <p class="font-body text-3xl text-stone-900">DM Sans</p>
            <p class="mt-1 text-stone-700">Everything else, including “Construction &amp; Development.”</p>
          </div>
          <p class="text-stone-700">
            Both are free from <a href="https://fonts.google.com" class="text-link" rel="noopener">Google Fonts</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
